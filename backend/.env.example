# SQLite database file (relative to backend/)
DATABASE_URL="file:./dev.db"
# Root directory for uploaded documents (private, outside any web-served path)
STORAGE_ROOT="./storage"
# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=25
# Lifetime of a signed download link, in seconds
DOWNLOAD_LINK_TTL_SECONDS=60

# --- API ---
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:5173"

# --- PDF generation (headless Chrome, Edge or Chromium; auto-detected if empty) ---
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
PDF_NO_SANDBOX=false

# --- Backups (AES-256-GCM encrypted; see docs/backup.md) ---
# A nightly backup runs inside the worker when both are set. KEEP THE PASSPHRASE SAFE: without it a backup cannot be restored.
# BACKUP_DIR="./backups"
# BACKUP_PASSPHRASE="at-least-12-characters-long-and-secret"
BACKUP_KEEP=14
